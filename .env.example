# Required outside development. Generate a long, random value and do not commit it.
# Example: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Single Source of Truth for Domain Configuration:
# - Local development: leave as localhost:3000
# - Production server: set to your custom subdomain (e.g. erp-portal.rapidtss.com)
APP_DOMAIN=localhost:3000

# Optional explicit URL overrides (automatically derived from APP_DOMAIN if omitted):
BETTER_AUTH_URL=http://localhost:3000

# Where the ERP stores system + per-business SQLite databases (defaults to ./data).
ERP_DATA_DIR=./data
