{
  "name": "modern-erp",
  "version": "2.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:validate": "NEXT_DIST_DIR=.next-validate next typegen && tsc --noEmit -p tsconfig.validate.json",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:push": "tsx --env-file=.env scripts/migrate.ts",
    "db:bootstrap": "tsx --env-file=.env scripts/bootstrap.ts",
    "db:check": "tsx --env-file=.env scripts/check-db.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "test": "node --import tsx --import ./scripts/test-isolation.mjs --test-force-exit --test \"tests/unit/**/*.test.ts\" \"tests/accounting/**/*.test.ts\" \"tests/platform/**/*.test.ts\" \"tests/integration/**/*.test.ts\"",
    "test:unit": "node --import tsx --import ./scripts/test-isolation.mjs --test-force-exit --test \"tests/unit/**/*.test.ts\"",
    "test:accounting": "node --import tsx --import ./scripts/test-isolation.mjs --test-force-exit --test \"tests/accounting/**/*.test.ts\"",
    "test:platform": "node --import tsx --import ./scripts/test-isolation.mjs --test-force-exit --test \"tests/platform/**/*.test.ts\"",
    "test:integration": "node --import tsx --import ./scripts/test-isolation.mjs --test-force-exit --test \"tests/integration/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:sprint3": "playwright test --config playwright.sprint3.config.ts",
    "build:ops": "node scripts/build-ops.mjs",
    "test:hardening": "tsx --test-force-exit --test tests/platform/production-hardening.test.ts",
    "check:permissions": "node scripts/check-permissions.mjs",
    "test:browser:hardening": "playwright test --config playwright.hardening.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.7.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-pdf/renderer": "^4.6.1",
    "@sentry/nextjs": "10.75.2",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.26",
    "better-auth": "1.7.14",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.2",
    "handlebars": "4.7.10",
    "jszip": "3.10.1",
    "lucide-react": "1.30.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "nodemailer": "10.2.1",
    "nuqs": "^2.10.3",
    "puppeteer": "^25.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "yazl": "^3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/handlebars": "^4.0.40",
    "@types/node": "^24.10.15",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.11",
    "typescript": "6.0.3"
  },
  "_comment_puppeteer": "Kept for custom-html template rendering path",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.4"
}
