# Canonical HTTPS entry point. Upstream retries are not a zero-downtime guarantee.
{$APP_DOMAIN:erp-portal.rapidtss.com} {
    encode gzip zstd
    request_body {
        max_size 55MB
    }
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    handle_path /_next/static/* {
        root * /srv/erp-static
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        reverse_proxy modern-erp:3000 {
            lb_try_duration 10s
            lb_try_interval 250ms
        }
    }
    handle_errors {
        header Retry-After 30
        respond "The service is restarting. Please retry shortly. Your unsaved entries remain in your browser." 503
    }
}

# HTTP IP access is restricted to readiness probes; login uses the configured HTTPS origin.
http://84.235.255.173, http://localhost {
    handle /api/health {
        reverse_proxy modern-erp:3000
    }
    handle {
        respond "Use the configured HTTPS application address." 404
    }
}
