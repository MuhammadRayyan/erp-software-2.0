# Caddyfile for Modern ERP
# Automatic HTTPS via Let's Encrypt / ZeroSSL for the configured subdomain.
# The {$APP_DOMAIN} environment variable is injected via docker-compose.
{$APP_DOMAIN:erp-portal.rapidtss.com} {
    encode gzip zstd

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Reverse proxy to Next.js container with automatic request buffering
    reverse_proxy modern-erp:3000 {
        # Buffer requests during container zero-downtime restarts
        lb_try_duration 10s
        lb_try_interval 250ms
    }
}

# Direct IP and localhost HTTP access (allows internal probes, health checks, and fallback):
http://84.235.255.173, http://localhost {
    encode gzip zstd

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    reverse_proxy modern-erp:3000 {
        lb_try_duration 10s
        lb_try_interval 250ms
    }
}
