# ==============================================================================
# Modern ERP Production Dockerfile (Next.js 16 Standalone + better-sqlite3 + Chromium)
# Compatible with x86_64 and ARM64 (Oracle Cloud Ampere A1)
# ==============================================================================

# Stage 1: Build & Dependencies
FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS builder
ARG APP_REVISION=development
ENV APP_REVISION=${APP_REVISION}
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Install native compilation toolchain for better-sqlite3
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps --include=dev

COPY . .

ENV NODE_ENV=production

RUN npm run build:ops \
    && ERP_DATA_DIR=/tmp/erp-build node .ops/ops.cjs migrate \
    && NEXT_PHASE=phase-production-build ERP_DATA_DIR=/tmp/erp-build npm run build

# Stage 2: Minimal Production Runner
FROM node:22-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS runner
WORKDIR /app

# Install runtime libraries for headless Chromium (PDF rendering) and SQLite
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    ca-certificates \
    fonts-liberation \
    curl \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV ERP_DATA_DIR=/app/data
ENV ERP_MIGRATION_MODE=external
ARG APP_REVISION=development
ENV APP_REVISION=${APP_REVISION}
LABEL org.opencontainers.image.source="https://github.com/MuhammadRayyan/erp-software-2.0" \
      org.opencontainers.image.revision=${APP_REVISION}

# Standalone output bundle generated by Next.js
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
COPY --from=builder /app/.ops ./tools

# Ensure persistent data directory exists
RUN groupadd --gid 10001 erp && useradd --uid 10001 --gid erp --no-create-home erp \
    && mkdir -p /app/data /app/.next/cache \
    && chown -R erp:erp /app
USER 10001:10001
VOLUME /app/data

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -f http://localhost:3000/api/health || exit 1

CMD ["node", "server.js"]
